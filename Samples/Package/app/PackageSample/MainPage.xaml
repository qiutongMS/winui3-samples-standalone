<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SDKTemplate.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SDKTemplate"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView
            x:Name="NavView"
            AutomationProperties.AutomationId="NavView"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="NavView_SelectionChanged"
            Grid.Row="0">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Identity" Tag="SDKTemplate.Scenario1" AutomationProperties.AutomationId="NavItem_Identity" />
                <NavigationViewItem Content="Installed Location" Tag="SDKTemplate.Scenario2" AutomationProperties.AutomationId="NavItem_InstalledLocation" />
                <NavigationViewItem Content="Dependencies" Tag="SDKTemplate.Scenario3" AutomationProperties.AutomationId="NavItem_Dependencies" />
            </NavigationView.MenuItems>
            <Frame x:Name="ScenarioFrame" />
        </NavigationView>

        <StackPanel x:Name="StatusPanel" Grid.Row="1" Orientation="Vertical">
            <TextBlock x:Name="StatusLabel" Margin="16,0,0,4" Text="Status:" Style="{ThemeResource CaptionTextBlockStyle}" />
            <Border x:Name="StatusBorder" Padding="16,8">
                <TextBlock x:Name="StatusBlock" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
            </Border>
        </StackPanel>
    </Grid>
</Page>
