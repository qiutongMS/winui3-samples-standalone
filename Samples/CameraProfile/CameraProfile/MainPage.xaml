<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SDKTemplate.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SDKTemplate"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="SampleTitle"
            Grid.Row="0"
            Margin="16,8,16,8"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="CameraProfile" />

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged"
            AutomationProperties.AutomationId="ScenarioNavigationView">
            <Frame x:Name="ScenarioFrame" Margin="12" />
        </NavigationView>

        <StackPanel
            x:Name="StatusPanel"
            Grid.Row="2"
            Orientation="Vertical">
            <TextBlock Margin="12,4,12,4" Text="Status:" />
            <Border x:Name="StatusBorder" Margin="0,0,0,0" Padding="12,8,12,8">
                <TextBlock
                    x:Name="StatusBlock"
                    MaxHeight="200"
                    AutomationProperties.LiveSetting="Assertive"
                    TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </Grid>
</Page>
