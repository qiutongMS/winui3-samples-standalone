<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AssociationLaunching.Scenario4_ReceiveUri"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer Margin="12,20,12,12">
            <StackPanel>
                <TextBlock Text="Description:" Style="{StaticResource SampleHeaderTextStyle}"/>
                <TextBlock Style="{StaticResource ScenarioDescriptionTextStyle}" TextWrapping="Wrap">
                    Receiving a URI.
                </TextBlock>

                <TextBlock Style="{StaticResource BasicTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0">
                    Use scenario 2 of this sample or another language version of this sample.
                    To test a custom scheme, enter alsdkcs://hello as the URI, then click
                    the "Launch default handler" button. To test an AppUriHandler, enter https://msdn.microsoft.com/.
                    Both links will launch this sample app into this page.
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
