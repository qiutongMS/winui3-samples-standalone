<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SDKTemplate.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SDKTemplate"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="SampleTitle" Text="Camera Resolution" Style="{StaticResource TitleTextBlockStyle}" Margin="16,8,0,8"/>

        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        SelectionChanged="NavView_SelectionChanged"
                        AutomationProperties.AutomationId="NavView">
            <NavigationView.MenuItems>
                <!-- Populated in code-behind -->
            </NavigationView.MenuItems>
            <Frame x:Name="ScenarioFrame" />
        </NavigationView>

        <StackPanel x:Name="StatusPanel" Grid.Row="2" Orientation="Vertical" Margin="0,0,0,0">
            <TextBlock x:Name="StatusLabel" Margin="16,4,0,4" TextWrapping="Wrap" Text="Status:" Style="{StaticResource CaptionTextBlockStyle}"/>
            <Border x:Name="StatusBorder" Margin="0,0,0,0" Padding="16,8">
                <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                    <TextBlock x:Name="StatusBlock" FontWeight="Bold"
                               AutomationProperties.LiveSetting="Assertive"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Grid>
</Page>
