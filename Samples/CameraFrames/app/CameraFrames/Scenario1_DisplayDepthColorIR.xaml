<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SDKTemplate.Scenario1_DisplayDepthColorIR"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="12,20,12,12">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <!-- If the screen is wide enough, then put the three previews side by side -->
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="600"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DepthPreviewBlock.(Grid.Row)" Value="0"/>
                        <Setter Target="DepthPreviewBlock.(Grid.Column)" Value="1"/>
                        <Setter Target="InfraredPreviewBlock.(Grid.Row)" Value="0"/>
                        <Setter Target="InfraredPreviewBlock.(Grid.Column)" Value="2"/>
                        <Setter Target="WideColumn1.Width" Value="*"/>
                        <Setter Target="WideColumn2.Width" Value="*"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel>
            <TextBlock Text="Description:" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
                    Display multiple frame sources to screen simultaneously in shared mode access.
            </TextBlock>

            <Button x:Name="NextButton"
                    AutomationProperties.AutomationId="NextButton"
                    Content="Next Source Group"
                    Click="NextButton_Click"
                    Margin="0,10,0,0"/>

            <Grid HorizontalAlignment="Stretch" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition x:Name="WideColumn1" Width="Auto"/>
                    <ColumnDefinition x:Name="WideColumn2" Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid x:Name="ColorPreviewBlock" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Grid.Column="0">
                    <StackPanel>
                        <TextBlock Text="Color frame source" HorizontalAlignment="Center"/>
                        <Image x:Name="colorPreviewImage" />
                    </StackPanel>
                </Grid>
                <Grid x:Name="DepthPreviewBlock" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Grid.Row="1">
                    <StackPanel>
                        <TextBlock Text="Depth frame source" HorizontalAlignment="Center"/>
                        <Image x:Name="depthPreviewImage"/>
                    </StackPanel>
                </Grid>
                <Grid x:Name="InfraredPreviewBlock" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Grid.Row="2">
                    <StackPanel>
                        <TextBlock Text="Infrared frame source" HorizontalAlignment="Center"/>
                        <Image x:Name="infraredPreviewImage"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <TextBlock x:Name="outputTextBlock" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
