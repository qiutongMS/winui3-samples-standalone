<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SDKTemplate.Scenario2_FindAvailableSourceGroups"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="12,20,12,12">
        <StackPanel>
            <TextBlock Text="Description:" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
                    Enumerate frame sources, and initialize selected source using frame reader and display frames on screen.
            </TextBlock>

            <Grid Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Source Group:" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Frame Source:" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Media Format:" VerticalAlignment="Center"/>
                <ComboBox x:Name="GroupComboBox"
                          AutomationProperties.AutomationId="GroupComboBox"
                          Grid.Row="0" Grid.Column="1"
                          SelectionChanged="GroupComboBox_SelectionChanged"
                          PlaceholderText="Select ..."
                          Margin="10,0,0,0"
                          DisplayMemberPath="DisplayName"/>
                <ComboBox x:Name="SourceComboBox"
                          AutomationProperties.AutomationId="SourceComboBox"
                          Grid.Row="1" Grid.Column="1"
                          SelectionChanged="SourceComboBox_SelectionChanged"
                          PlaceholderText="Select ..."
                          Margin="10,0,0,0"
                          DisplayMemberPath="DisplayName"/>
                <ComboBox x:Name="FormatComboBox"
                          AutomationProperties.AutomationId="FormatComboBox"
                          Grid.Row="2" Grid.Column="1"
                          SelectionChanged="FormatComboBox_SelectionChanged"
                          PlaceholderText="Default format"
                          Margin="10,0,0,0"
                          DisplayMemberPath="DisplayName"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Start"
                        x:Name="StartButton"
                        AutomationProperties.AutomationId="StartButton"
                        IsEnabled="False"
                        Click="StartButton_Click"/>
                <Button Content="Stop"
                        x:Name="StopButton"
                        AutomationProperties.AutomationId="StopButton"
                        IsEnabled="False"
                        Click="StopButton_Click"
                        Margin="10,0,0,0"/>
            </StackPanel>

            <Image x:Name="PreviewImage" Margin="0,10,0,0"/>

            <TextBlock x:Name="outputTextBlock" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
