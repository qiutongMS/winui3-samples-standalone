<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CameraAdvancedCapture.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CameraAdvancedCapture"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="TranslucentBlackBrush" Color="Black" Opacity="0.3"/>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <!-- Fallback UI shown when camera is unavailable -->
        <StackPanel x:Name="FallbackPanel" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="12" Padding="24">
            <TextBlock Text="This sample requires a camera device that is not available on this machine."
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       TextWrapping="WrapWholeWords" HorizontalAlignment="Center"/>
            <TextBlock x:Name="FallbackErrorText"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                       TextWrapping="WrapWholeWords" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Camera preview -->
        <MediaPlayerElement x:Name="PreviewControl" Stretch="Uniform"
                            AutomationProperties.AutomationId="PreviewControl"/>

        <!-- Advanced Capture Mode + Photo buttons -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
            <StackPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Margin" Value="10,40"/>
                    <Setter Property="MinWidth" Value="80"/>
                    <Setter Property="MinHeight" Value="80"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="{StaticResource TranslucentBlackBrush}"/>
                    <Setter Property="BorderBrush" Value="White"/>
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                </Style>
            </StackPanel.Resources>

            <!-- Advanced capture cycle button -->
            <Button x:Name="CycleModeButton" IsEnabled="False"
                    AutomationProperties.AutomationId="CycleModeButton">
                <Viewbox MaxWidth="60" MaxHeight="60">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <SymbolIcon Grid.Row="0" Symbol="AttachCamera"/>
                        <TextBlock x:Name="ModeTextBlock" Grid.Row="1" Text="Standard" HorizontalAlignment="Center" FontSize="8"/>
                    </Grid>
                </Viewbox>
            </Button>

            <!-- Take photo button -->
            <Button x:Name="PhotoButton" Click="PhotoButton_Click" IsEnabled="False"
                    AutomationProperties.AutomationId="PhotoButton">
                <Viewbox MaxWidth="40" MaxHeight="40">
                    <SymbolIcon Symbol="Camera"/>
                </Viewbox>
            </Button>
        </StackPanel>

        <!-- HDR analyzer bar -->
        <Grid VerticalAlignment="Bottom" Background="{StaticResource TranslucentBlackBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="HDR Analyzer:" Foreground="White" Margin="10"/>
            <ProgressBar x:Name="HdrImpactBar" Grid.Column="1" MinHeight="20" Margin="10" Opacity="0.75"
                         AutomationProperties.AutomationId="HdrImpactBar"/>
            <TextBlock x:Name="SceneTypeTextBlock" Grid.Column="2" Foreground="White" Margin="10"/>
        </Grid>
    </Grid>
</Page>
