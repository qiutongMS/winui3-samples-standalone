<Page x:Class="ApplicationDataSample.Scenario6_ClearScenario"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}">
                The <Bold>ClearAsync</Bold> method clears data from ApplicationData.
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="Clear" AutomationProperties.AutomationId="ClearButton" Content="Clear" Margin="0,0,10,0" Click="Clear_Click"/>
            </StackPanel>
            <TextBlock x:Name="OutputTextBlock" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
