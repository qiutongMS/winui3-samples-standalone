<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ApplicationDataSample.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ApplicationDataSample"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView
            x:Name="NavView"
            AutomationProperties.AutomationId="NavView"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem AutomationProperties.AutomationId="NavItemFiles" Content="Files" Tag="ApplicationDataSample.Scenario1_Files" />
                <NavigationViewItem AutomationProperties.AutomationId="NavItemSettings" Content="Settings" Tag="ApplicationDataSample.Scenario2_Settings" />
                <NavigationViewItem AutomationProperties.AutomationId="NavItemSettingContainer" Content="Setting Container" Tag="ApplicationDataSample.Scenario3_SettingContainer" />
                <NavigationViewItem AutomationProperties.AutomationId="NavItemCompositeSettings" Content="Composite Settings" Tag="ApplicationDataSample.Scenario4_CompositeSettings" />
                <NavigationViewItem AutomationProperties.AutomationId="NavItemClear" Content="Clear" Tag="ApplicationDataSample.Scenario6_ClearScenario" />
                <NavigationViewItem AutomationProperties.AutomationId="NavItemSetVersion" Content="SetVersion" Tag="ApplicationDataSample.Scenario7_SetVersion" />
            </NavigationView.MenuItems>

            <Frame x:Name="ScenarioFrame" />
        </NavigationView>

        <StackPanel x:Name="StatusPanel" Grid.Row="1" Orientation="Vertical">
            <TextBlock x:Name="StatusLabel" Margin="16,0,0,4" Text="Status:" Style="{StaticResource CaptionTextBlockStyle}" />
            <Border x:Name="StatusBorder" Margin="0,0,0,0">
                <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                    <TextBlock x:Name="StatusBlock" FontWeight="Bold"
                               AutomationProperties.LiveSetting="Assertive"
                               Margin="16,4,16,16" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Grid>
</Page>
