<Page x:Class="ApplicationDataSample.Scenario3_SettingContainer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}">
                Settings containers are used to organize settings into groups.
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="CreateContainer" AutomationProperties.AutomationId="CreateContainer" Content="Create Container" Margin="0,0,10,0" Click="CreateContainer_Click"/>
                <Button x:Name="DeleteContainer" AutomationProperties.AutomationId="DeleteContainer" Content="Delete Container" Margin="0,0,10,0" Click="DeleteContainer_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="WriteSetting" AutomationProperties.AutomationId="WriteSettingContainer" Content="Write Setting" Margin="0,0,10,0" Click="WriteSetting_Click" IsEnabled="False"/>
                <Button x:Name="DeleteSetting" AutomationProperties.AutomationId="DeleteSettingContainer" Content="Delete Setting" Margin="0,0,10,0" Click="DeleteSetting_Click" IsEnabled="False"/>
            </StackPanel>
            <TextBlock x:Name="OutputTextBlock" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
